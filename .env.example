# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional/Required for OpenRouter free/open tier model fallback (Level 23 Hybrid AI Router)
OPENROUTER_API_KEY=""

# COURTLISTENER_API_TOKEN: Optional CourtListener API Token for docket and opinion searches.
# Sign up at https://www.courtlistener.com/api/ to get your token.
#
# GOOGLE_CLOUD_PROJECT: Required for Google Cloud Document AI processing.
GOOGLE_CLOUD_PROJECT=""
# DOCUMENT_AI_LOCATION: Region for Document AI processors (defaults to "us").
DOCUMENT_AI_LOCATION="us"
# DOCUMENT_AI_PROCESSOR_ID: The unique processor ID from the GCP Console.
DOCUMENT_AI_PROCESSOR_ID=""
#
COURTLISTENER_API_TOKEN=""

# DEFAULT_AI_PROVIDER: Options are "GEMINI", "OPEN_MODEL", or "HYBRID_AUTO"
DEFAULT_AI_PROVIDER="GEMINI"

# OPEN_MODEL_ENDPOINT: OpenAI-compatible API endpoint for open models like Google Gemma (via Ollama, vLLM, LM Studio, etc.)
OPEN_MODEL_ENDPOINT="http://localhost:11434/v1/chat/completions"

# OPEN_MODEL_NAME: Name of the open model (e.g. gemma2, gemma-2-9b-it, llama3.2, qwen2.5)
OPEN_MODEL_NAME="gemma2"

# OPEN_MODEL_API_KEY: Optional API key or bearer token if hosting open model on a secured cloud endpoint
OPEN_MODEL_API_KEY=""
