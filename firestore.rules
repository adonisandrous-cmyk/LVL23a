rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Matters/Cases Collection
    match /matters/{matterId} {
      allow read, write: if true;
    }

    // Generated Documents Briefs/Pleadings
    match /generatedDocs/{docId} {
      allow read, write: if true;
    }

    // Scanned Evidence Files OCR data
    match /evidenceFiles/{fileId} {
      allow read, write: if true;
    }

    // AI Specialist Chat Logs Thread
    match /chatThread/{msgId} {
      allow read, write: if true;
    }

    // Agent Progress Milestones
    match /agentProgressList/{agentId} {
      allow read, write: if true;
    }

    // Active Consultation Sessions
    match /consultations/{sessionId} {
      allow read, write: if true;
    }
  }
}
